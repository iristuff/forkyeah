# Copy to .env.local for `vercel dev`. Never commit real values.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Required: Google AI Studio key for the Sous Chef + dish scoring
GEMINI_API_KEY=

# Optional: override the model (default: gemini-flash-latest)
GEMINI_MODEL=

# Optional: extra origins allowed to call /api (comma-separated), e.g. a custom domain
ALLOWED_ORIGINS=

# Optional: shared rate limits across serverless instances (free Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
