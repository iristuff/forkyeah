# Copy to .env.local for `vercel dev`. Never commit real values.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Required: Google AI Studio key for the Sous Chef + dish scoring
GEMINI_API_KEY=

# Optional: override the model (default: gemini-flash-lite-latest)
GEMINI_MODEL=

# Optional: extra origins allowed to call /api (comma-separated), e.g. a custom domain
ALLOWED_ORIGINS=

# Optional: shared rate limits across serverless instances (free Upstash Redis).
# The Vercel Marketplace integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; either works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Firebase (accounts + cloud sync). Public web config, NOT secrets: it identifies the
# project and Firestore rules (firestore.rules) protect the data. Leave empty for a
# guest-only build. Values: Firebase console → Project settings → Your apps → Config.
# Production uses the app's own domain as AUTH_DOMAIN (vercel.json proxies /__/auth).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
