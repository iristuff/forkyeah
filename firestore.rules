rules_version = '2';

// Fork Yeah Firestore rules. Paste into Firebase console → Firestore → Rules → Publish.
// Each player has one document, users/{uid}, written by src/lib/firebase.ts:
//   { progress: map, schema: int, updatedAt: server timestamp }
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validProgressDoc() {
        let d = request.resource.data;
        return d.keys().hasOnly(['progress', 'schema', 'updatedAt'])
          && d.progress is map
          && d.schema is int && d.schema >= 1 && d.schema < 1000
          && d.updatedAt == request.time;
      }

      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validProgressDoc();
    }

    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
